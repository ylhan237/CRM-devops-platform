<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Rules for the CRM backend.

    Scope: defects, not style. Every rule here catches something that can be
    wrong at runtime, or that the compiler already assumes and cannot check.
    Formatting and naming are deliberately absent: Spotless owns the
    formatting, and a rule set that fights the formatter makes both useless.

    The set is intentionally short. The service code predates any static
    analysis, so a broad ruleset would produce a wall of violations on the day
    it is switched on, and a check that is red from the start is a check people
    learn to ignore. Rules get added here as the existing code is brought into
    line, not all at once.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!--
        Trailing whitespace and a missing final newline are formatting, but
        they produce noisy diffs, so they are warnings rather than build
        failures.
    -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
        <property name="severity" value="warning"/>
    </module>
    <module name="NewlineAtEndOfFile">
        <property name="severity" value="warning"/>
    </module>

    <module name="TreeWalker">

        <!-- Imports -->
        <module name="AvoidStarImport"/>
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="IllegalImport"/>

        <!--
            The correctness rules.

            Each of these is a way to write code that compiles and then behaves
            differently from what it looks like, which is exactly the class of
            defect this project has been shipping.
        -->
        <module name="EqualsHashCode"/>
        <module name="EqualsAvoidNull"/>
        <module name="StringLiteralEquality"/>
        <module name="MissingSwitchDefault"/>
        <module name="MissingOverride"/>
        <module name="EmptyStatement"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="FallThrough"/>
        <module name="IllegalInstantiation">
            <!-- new Integer(..), new Boolean(..), new Long(..) -->
            <property name="tokens"
                      value="NUM_DOUBLE, NUM_FLOAT, NUM_INT, NUM_LONG,
                             STRING_LITERAL, LITERAL_NEW"/>
        </module>
        <module name="CovariantEquals"/>
        <module name="NoFinalizer"/>

    </module>
</module>
