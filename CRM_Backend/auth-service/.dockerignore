# Keep the build context minimal and reproducible.
#
# The Dockerfile copies pom.xml first so that dependency resolution is cached,
# then copies src. Anything else in this directory is noise: shipping it wastes
# context and risks overriding the result of the in-image Maven run.

# Produced inside the image
target
bin

# JVM crash artifacts
*.log
hs_err_pid*.log
replay_pid*.log

# Version control and tooling
.git
.gitignore
.gitattributes
.mvn/wrapper/maven-wrapper.jar
.vscode
.idea
*.iml

# Local environment and credentials
.env
.env.*
!.env.example

# Runtime data written by the service
uploads/

# Editor files
.DS_Store
Thumbs.db
*.swp